{
  "name": "nexus-pm-billing",
  "private": true,
  "version": "1.0.0",
  "description": "NEXUS — Project Management & Client Billing System (DBMS mini-project frontend)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "server": "node server/server.js",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "db:migrate": "node server/scripts/run-migrations.js",
    "db:seed": "node server/seeds/seed.js",
    "db:reset": "node server/scripts/reset-db.js",
    "test": "tsx --test server/tests/*.test.js server/tests/*.test.ts",
    "start": "node server/server.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
